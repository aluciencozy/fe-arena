PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
# Optional: when both are set, reviewed questions load from Supabase server-side.
SUPABASE_URL=
# Publishable/anon key used only by server-side Auth token verification.
SUPABASE_PUBLISHABLE_KEY=
# Server-only key for persistence and question loading. Never expose to the frontend.
SUPABASE_SECRET_KEY=
