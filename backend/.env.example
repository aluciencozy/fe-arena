# Local defaults. Production requires explicit PORT, FRONTEND_ORIGINS, and TRUST_PROXY.
NODE_ENV=development
PORT=3001
# Comma-separated exact browser origins. FRONTEND_ORIGIN remains supported for one origin.
FRONTEND_ORIGINS=http://localhost:5173
TRUST_PROXY=false
# Optional: when both server variables are set, reviewed questions and terminal history use Supabase.
SUPABASE_URL=
# Publishable/anon key used only by server-side Auth token verification.
SUPABASE_PUBLISHABLE_KEY=
# Server-only key for persistence and question loading. Never expose to the frontend.
SUPABASE_SECRET_KEY=
